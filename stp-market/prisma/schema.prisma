// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[]
}

enum ProductApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Product {
  id             String                @id @default(cuid())
  name           String
  slug           String                @unique
  description    String
  price          Float
  imageUrl       String
  stock          Int
  active         Boolean               @default(true)
  approvalStatus ProductApprovalStatus @default(APPROVED)
  categoryId     String
  category       Category              @relation(fields: [categoryId], references: [id])
  vendorId       String?
  vendor         Vendor?               @relation(fields: [vendorId], references: [id])
  orderItems     OrderItem[]
  createdAt      DateTime              @default(now())
}

model Customer {
  id         String  @id @default(cuid())
  name       String
  email      String  @unique
  password   String?
  phone      String
  address    String
  city       String
  postalCode String
  country    String
  orders     Order[]
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id              String      @id @default(cuid())
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id])
  stripePaymentId String?     @unique
  total           Float
  status          OrderStatus @default(PENDING)
  items           OrderItem[]
  createdAt       DateTime    @default(now())
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  order            Order   @relation(fields: [orderId], references: [id])
  productId        String
  product          Product @relation(fields: [productId], references: [id])
  quantity         Int
  price            Float
  vendorId         String?
  vendor           Vendor? @relation(fields: [vendorId], references: [id])
  vendorAmount     Float?
  commissionAmount Float?
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
}

model Vendor {
  id        String              @id @default(cuid())
  name      String
  email     String              @unique
  password  String
  phone     String
  message   String?
  status    VendorStatus        @default(PENDING)
  createdAt DateTime            @default(now())
  products  Product[]
  orderItems       OrderItem[]
  withdrawals      WithdrawalRequest[]
}

enum WithdrawalStatus {
  PENDING
  PAID
}

model WithdrawalRequest {
  id        String           @id @default(cuid())
  vendorId  String
  vendor    Vendor           @relation(fields: [vendorId], references: [id])
  amount    Float
  status    WithdrawalStatus @default(PENDING)
  createdAt DateTime         @default(now())
  paidAt    DateTime?
}
